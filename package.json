{
  "name": "samwitte_pcb",
  "version": "1.3.0",
  "description": "samwitte.com/pcb: freelance PCB design page and quote form. Built with Parcel 2.",
  "devDependencies": {
    "parcel": "^2.12.0",
    "shx": "^0.3.4"
  },
  "scripts": {
    "start": "parcel src/index.html",
    "prebuild-dev": "shx rm -rf dist/*",
    "build-dev": "parcel build ./src/index.html --no-optimize --public-url ./",
    "prebuild": "shx rm -rf dist/*",
    "build": "parcel build ./src/index.html --public-url ./",
    "push-gh-pages": "push-dir --dir=dist --remote=pcb --branch=gh-pages --cleanup --verbose"
  },
  "dependencies": {
    "push-dir": "^0.4.1"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
